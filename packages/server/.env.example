# Copy this file to `.env` and fill in real values.
# Never commit `.env` itself.

# ⚠️ GENERATE A NEW VALUE — do NOT use the placeholder below in production.
# Server will refuse to start in NODE_ENV=production if JWT_SECRET is missing/short.
# Generate one: `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=replace-with-a-long-random-string

# JWT lifetime. Default: 30d. Shorter = better security if token leaks.
JWT_TTL=30d

# WebSocket / HTTP port the Colyseus + Express server listens on.
PORT=2567

# Optional: enable multi-instance scale-out via Redis pub/sub.
# Required when running >1 server replica (k8s, fly.io, multi-region).
# Unset = single-instance mode (in-memory presence).
# REDIS_URL=redis://localhost:6379

# Optional: CORS allowlist for production. Comma-separated.
# Unset in dev = permissive.
# CORS_ORIGINS=https://aetheria.example.com,https://www.aetheria.example.com

# Log level: debug | info | warn | error. Default: debug in dev, info in prod.
# LOG_LEVEL=info

# Optional: spawn N AI bot players for solo multiplayer testing (0 = none).
# Set to e.g. 3 to fill the village with cheerful NPCs.
DEV_BOTS=0

# Database. Default is SQLite for dev; set DATABASE_URL to a Postgres URL for prod.
# SQLite (dev default):
#   DATABASE_URL="file:./prisma/dev.db"
# Postgres (prod):
#   DATABASE_URL="postgresql://aetheria:aetheria@localhost:5432/aetheria?schema=public"
# To switch providers, also change `provider = "postgresql"` in prisma/schema.prisma
# and run `pnpm db:migrate` against the new database.
# DATABASE_URL=
