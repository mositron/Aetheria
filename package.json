{
  "name": "game-v1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./packages/*\" dev",
    "dev:server": "pnpm --filter @game/server dev",
    "dev:client": "pnpm --filter @game/client dev",
    "build": "pnpm -r build",
    "db:push": "pnpm --filter @game/server db:push",
    "seed:load-bots": "pnpm --filter @game/server exec tsx ../../tools/seed-load-bots.ts",
    "test:harness": "pnpm --filter @game/server exec tsx ../../tools/harness-runner.ts",
    "loadtest": "k6 run tools/k6/loadtest-room.js",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.59.4",
    "@typescript-eslint/parser": "^8.59.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ioredis-mock": "^8.13.1",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@10.32.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "msgpackr-extract"
    ]
  }
}
