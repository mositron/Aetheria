# Copy to .env then `docker compose up -d`.
# `docker compose` reads .env from the project root automatically.

# Postgres password — used by both postgres service and DATABASE_URL.
POSTGRES_PASSWORD=aetheria_dev

# JWT signing key — MUST be ≥32 chars random in real production.
#   openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-at-least-32-chars

# Admin token for /metrics dashboard. Pick anything random for local.
ADMIN_TOKEN=local-admin

# Comma-separated list of allowed CORS origins (full URLs incl. scheme).
# LAN addresses are auto-allowed for dev — only set this on the production VPS.
# ALLOWED_ORIGINS=https://aetheria.example.com,https://api.aetheria.example.com

# Set to "true" on the VPS so Express redirects http → https
# (Caddy/nginx in front terminates TLS and sets x-forwarded-proto).
# ENFORCE_HTTPS=false

# Optional: enable Sentry error tracking.
# SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx

# Optional: hCaptcha keys to enable register-page bot protection.
# Both must be set together. Sign up free at https://www.hcaptcha.com
# CAPTCHA_SECRET=0xSecretKey
# VITE_CAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001
