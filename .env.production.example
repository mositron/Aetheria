# Copy to .env then `docker compose up -d`.
# `docker compose` reads .env from the project root automatically.

# ── REQUIRED in production (NODE_ENV=production) ─────────────────────────────
# Server exits at startup if any of these is missing.

# Postgres password — used by both postgres service and DATABASE_URL.
POSTGRES_PASSWORD=aetheria_dev

# JWT signing key — MUST be ≥32 chars random in real production.
#   openssl rand -base64 48
JWT_SECRET=local-dev-secret-change-me-at-least-32-chars

# Redis URL — REQUIRED in production. Refresh-token storage + revocation rely
# on Redis; without it /logout and /recovery/reset-password cannot invalidate
# sessions and /refresh would accept stolen tokens indefinitely.
REDIS_URL=redis://redis:6379

# Admin token for /metrics dashboard. Pick anything random for local.
# Accepted via Authorization: Bearer header or admin_token cookie.
# Legacy ?token= still works but redirects to scrub the URL.
ADMIN_TOKEN=local-admin

# ── STRONGLY RECOMMENDED in production ───────────────────────────────────────

# Comma-separated User.id (cuid) list granted access to /api/admin/audit.
# When unset, the endpoint returns 503 — fresh deploys never silently leak
# audit logs to any authenticated user.
# ADMIN_USER_IDS=cuid_for_alice,cuid_for_bob

# Comma-separated list of allowed CORS origins (full URLs incl. scheme).
# LAN addresses are auto-allowed for dev — only set this on the production VPS.
# ALLOWED_ORIGINS=https://aetheria.example.com,https://api.aetheria.example.com

# Set to "true" on the VPS so Express redirects http → https
# (Caddy/nginx in front terminates TLS and sets x-forwarded-proto).
# ENFORCE_HTTPS=false

# Number of trusted upstream proxy hops. Default: 1 in prod / 0 in dev.
# Required for rate-limit to see real client IPs instead of the proxy IP.
# Increase if there are multiple proxies (e.g. CDN → Caddy → server = 2).
# TRUST_PROXY=1

# hCaptcha keys — STRONGLY RECOMMENDED in production. When CAPTCHA_SECRET is
# unset in prod, /register fail-closes (refuses all submissions); the server
# logs a startup warning so a misconfigured deploy is obvious.
# Sign up free at https://www.hcaptcha.com
# CAPTCHA_SECRET=0xSecretKey
# VITE_CAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Enable Sentry error tracking.
# SENTRY_DSN=https://xxx@oxxx.ingest.sentry.io/xxx

# AuditService fallback log path. When the DB write fails, the audit entry is
# appended here as JSON-per-line so security events survive DB outages.
# Default: audit-fallback.log in the server CWD.
# AUDIT_FALLBACK_LOG=/var/log/aetheria/audit-fallback.log
